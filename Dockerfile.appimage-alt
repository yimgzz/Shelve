# shelve-appimage-alt — AppImage packaging toolchain on ALT Linux p11.
#
# Why this exists (master plan §11 risk row: "WebKitGTK 6.0 availability on
# target distros"): an AppImage bundles every runtime library EXCEPT glibc and
# libstdc++, which always come from the host. The trixie-based shelve-dev image
# (glibc 2.41, GCC 14) therefore produced AppImages that only started on hosts
# with glibc >= 2.39 and libstdc++ CXXABI_1.3.15. alt:p11 ships glibc 2.38 +
# GCC 13.2.1 (CXXABI <= 1.3.14) + WebKitGTK 6.0 (libwebkitgtk6.0 2.48), so an
# AppImage built here runs on any Linux with glibc >= 2.38 and a GCC >= 13
# libstdc++: ALT p10/p11, Ubuntu 24.04+, Fedora 39+, Debian 13, Arch.
#
# Scope: this image is used ONLY by `make appimage-alt`. Build/test/lint/dev
# stay on the trixie-based `shelve-dev` image.
FROM alt:p11

# Pinned Wails v3 CLI version (must match Dockerfile.dev and go.mod).
ARG WAILS3_VERSION=v3.0.0-beta.20

# ALT's apt is rpm-backed and does NOT support --no-install-recommends.
# Package groups:
#   build toolchain ....... gcc, gcc-c++, make, pkg-config
#   GUI dev stack ......... libwebkitgtk6.0-devel pulls libgtk4-devel and
#                           libsoup3.0-devel; glib2-devel,
#                           gobject-introspection-devel, libgdk-pixbuf-devel,
#                           libpango-devel, librsvg-devel provide the .pc files
#                           and helper tools (glib-compile-schemas,
#                           gdk-pixbuf-query-loaders) required by the
#                           linuxdeploy-plugin-gtk.sh embedded in the wails3 CLI.
#   frontend .............. node (22 LTS) + npm
#   Go ..................... golang 1.26 (>= the go.mod `go 1.25` directive)
#   AppImage pipeline ..... file (linuxdeploy), findutils + bash (gtk plugin),
#                           binutils (readelf), glibc-utils (ldd), coreutils
#                           (cp --parents / realpath), sed, tar, xz, wget,
#                           ca-certificates, git (safe.directory / VCS).
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        gcc gcc-c++ make pkg-config \
        libwebkitgtk6.0-devel \
        glib2-devel gobject-introspection-devel \
        libgdk-pixbuf-devel libpango-devel librsvg-devel \
        node npm golang \
        file findutils binutils glibc-utils coreutils sed tar xz fuse3 wget ca-certificates bash git \
 && rm -rf /var/lib/apt/lists/*

# Pin the Wails v3 CLI next to the rest of the toolchain. GOPATH is fixed to
# /go so the module cache lands in the same named volume (shelve-dev-gomod)
# that the Makefile mounts for the other container targets.
ENV GOPATH=/go
RUN go install github.com/wailsapp/wails/v3/cmd/wails3@${WAILS3_VERSION} \
 && ln -sf /go/bin/wails3 /usr/local/bin/wails3

# The repo is mounted at /app, owned by the host user, while the container
# runs as root: declare /app a safe git directory so `go build`'s VCS
# stamping and git calls work (git >= 2.35.2 "dubious ownership" guard).
RUN git config --system --add safe.directory /app

WORKDIR /app

# Wails subcommands are the default entrypoint
# (`docker run shelve-dev-appimage-alt task linux:create:appimage`).
ENTRYPOINT ["wails3"]