{
  "name": "shelve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first SSH session manager (Electron shell + Go backend)",
  "desktopName": "shelve.desktop",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:renderer": "vite build frontend --mode production",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dev:renderer": "vite frontend",
    "dev:electron": "node scripts/build-electron.mjs && electron ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "electron": "42.10.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "vite": "^8.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
